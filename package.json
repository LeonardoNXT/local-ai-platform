{
  "name": "local-ai-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev:auth": "pnpm --filter @local-ai/auth-service exec nest start --watch",
    "build:auth": "pnpm --filter @local-ai/auth-service exec nest build",
    "generate:proto": "cd ./packages/shared/grpc/ && pnpm run build",
    "docker:up": "cd ./infra && docker compose up --build",
    "docker:down": "cd ./infra && docker compose -f docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "protobufjs": "^8.5.0",
    "protoc": "^25.9.0",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.8",
    "tsx": "^4.22.4",
    "typescript": "latest",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1"
  }
}
